{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "aspen",
  "name": "Cube Hosting",
  "description": "Documentação da Cube Hosting: hospede bots de Discord, sites e APIs em Node.js e Python enviando um .zip, e automatize tudo pela API.",
  "colors": {
    "primary": "#796CFC",
    "light": "#6FB4FF",
    "dark": "#8B37ED"
  },
  "logo": {
    "light": "/logo/light.png",
    "dark": "/logo/dark.png",
    "href": "https://docs.cubehosting.com.br"
  },
  "favicon": "/favicon.png",
  "appearance": {
    "default": "dark",
    "strict": true
  },
  "background": {
    "color": {
      "light": "#F4F4F4",
      "dark": "#07090F"
    },
    "decoration": "gradient"
  },
  "fonts": {
    "heading": {
      "family": "Geist",
      "weight": 600
    },
    "body": {
      "family": "Geist",
      "weight": 400
    }
  },
  "icons": {
    "library": "lucide"
  },
  "styling": {
    "codeblocks": "dark"
  },
  "navigation": {
    "languages": [
      {
        "language": "pt-BR",
        "tabs": [
          {
            "tab": "Guias",
            "icon": "book-open",
            "groups": [
              {
                "group": "Começando",
                "pages": [
                  "index",
                  "quickstart",
                  "cube-json"
                ]
              },
              {
                "group": "Hospedagem",
                "pages": [
                  "hosting/discord-bots",
                  "hosting/sites-and-apis",
                  "hosting/environment-variables",
                  "hosting/files",
                  "hosting/backups",
                  "hosting/versions",
                  "hosting/databases",
                  "hosting/blob",
                  "hosting/logs-and-metrics",
                  "hosting/alerts",
                  "hosting/domains",
                  "hosting/zip-limits"
                ]
              },
              {
                "group": "Conta e planos",
                "pages": [
                  "account/plans",
                  "account/pix-billing",
                  "account/free-plan",
                  "account/security"
                ]
              },
              {
                "group": "Cube AI",
                "pages": [
                  "cube-ai"
                ]
              },
              {
                "group": "Ferramentas",
                "pages": [
                  "tools",
                  "account-mcp",
                  "cli",
                  "github",
                  "github-actions"
                ]
              },
              {
                "group": "Segurança",
                "pages": [
                  "security"
                ]
              }
            ]
          },
          {
            "tab": "Referência da API",
            "icon": "terminal",
            "groups": [
              {
                "group": "Visão geral",
                "pages": [
                  "api-reference/introduction"
                ]
              },
              {
                "group": "Projetos",
                "pages": [
                  "api-reference/projects/list",
                  "api-reference/projects/get",
                  "api-reference/projects/create",
                  "api-reference/projects/upload-code"
                ]
              },
              {
                "group": "Controle",
                "pages": [
                  "api-reference/projects/start",
                  "api-reference/projects/stop",
                  "api-reference/projects/restart"
                ]
              },
              {
                "group": "Logs e métricas",
                "pages": [
                  "api-reference/projects/logs",
                  "api-reference/projects/metrics"
                ]
              },
              {
                "group": "Variáveis de ambiente",
                "pages": [
                  "api-reference/projects/list-variables",
                  "api-reference/projects/set-variables"
                ]
              },
              {
                "group": "Backups",
                "pages": [
                  "api-reference/backups/list",
                  "api-reference/backups/create",
                  "api-reference/backups/download-link",
                  "api-reference/backups/download",
                  "api-reference/backups/restore"
                ]
              },
              {
                "group": "Versões dos envios",
                "pages": [
                  "api-reference/deployments/list",
                  "api-reference/deployments/download-link",
                  "api-reference/deployments/download",
                  "api-reference/deployments/rollback"
                ]
              },
              {
                "group": "Bancos de dados",
                "pages": [
                  "api-reference/databases/list",
                  "api-reference/databases/get",
                  "api-reference/databases/create",
                  "api-reference/databases/credentials",
                  "api-reference/databases/start",
                  "api-reference/databases/stop",
                  "api-reference/databases/backups",
                  "api-reference/databases/backup-download-link",
                  "api-reference/databases/backup-download"
                ]
              },
              {
                "group": "Blob",
                "pages": [
                  "api-reference/blob/list",
                  "api-reference/blob/create",
                  "api-reference/blob/complete",
                  "api-reference/blob/get",
                  "api-reference/blob/download-url",
                  "api-reference/blob/delete"
                ]
              },
              {
                "group": "Avisos",
                "pages": [
                  "api-reference/projects/alerts"
                ]
              },
              {
                "group": "Conta",
                "pages": [
                  "api-reference/account/usage"
                ]
              }
            ]
          },
          {
            "tab": "Solução de problemas",
            "icon": "life-buoy",
            "groups": [
              {
                "group": "Por tema",
                "pages": [
                  "troubleshooting/app-wont-start",
                  "troubleshooting/discord-bots",
                  "troubleshooting/memory",
                  "troubleshooting/sites"
                ]
              },
              {
                "group": "Códigos de erro",
                "pages": [
                  "errors"
                ]
              }
            ]
          }
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "Painel",
          "href": "https://app.cubehosting.com.br",
          "icon": "layout-dashboard"
        },
        {
          "anchor": "Discord",
          "href": "https://discord.gg/pv6D9tUsDV",
          "icon": "message-circle"
        },
        {
          "anchor": "Site",
          "href": "https://cubehosting.com.br",
          "icon": "globe"
        }
      ]
    }
  },
  "navbar": {
    "links": [
      {
        "label": "Suporte",
        "href": "https://discord.gg/pv6D9tUsDV"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Painel",
      "href": "https://app.cubehosting.com.br"
    }
  },
  "footer": {
    "socials": {
      "discord": "https://discord.gg/pv6D9tUsDV",
      "website": "https://cubehosting.com.br"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ]
  },
  "api": {
    "openapi": "api-reference/openapi.json",
    "playground": {
      "display": "simple"
    },
    "examples": {
      "autogenerate": false,
      "prefill": false
    }
  },
  "search": {
    "prompt": "Buscar na documentação…"
  },
  "seo": {
    "metatags": {
      "og:locale": "pt_BR",
      "og:site_name": "Cube Hosting"
    }
  },
  "errors": {
    "404": {
      "redirect": false,
      "title": "Página não encontrada",
      "description": "Este endereço não existe na documentação. Volte para a [Introdução](/) ou use a busca."
    }
  }
}
